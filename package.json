{
  "name": "saas-media-optimizer",
  "version": "1.0.0",
  "description": "Microservicio SaaS de alto rendimiento para optimización, redimensionamiento y compresión de medios en memoria utilizando Sharp y Node.js 22 LTS.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "saas",
    "sharp",
    "image-optimizer",
    "webp",
    "media-pipeline",
    "nodejs",
    "typescript"
  ],
  "author": "Daniel Jiménez <https://github.com/stonedjjh> (stonecraft)",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.0.0",
    "multer": "1.4.5-lts.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rotating-file-stream": "^3.2.10",
    "sharp": "^0.33.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.9",
    "@types/pino-http": "^6.1.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
