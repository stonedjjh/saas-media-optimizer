PORT=4000
NODE_ENV=development
MAX_FILE_SIZE_MB=25
MAX_IMAGE_DIMENSION=4000

# Seguridad: Si está vacío, opera abierto sin autenticación. Si tiene valor, exige x-api-key o Bearer token.
API_KEY=

# Rate Limiting: Máximo de peticiones permitidas por IP en la ventana de tiempo (en minutos)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Concurrencia de Sharp: Máximo de trabajos procesados en paralelo y límite de espera en cola
MAX_CONCURRENT_JOBS=4
MAX_QUEUE_WAITING=10

# Logging: Días de retención antes de purgar logs rotados automáticamente
LOG_RETENTION_DAYS=30
LOG_LEVEL=info
